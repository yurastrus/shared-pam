msgstr "Amphibians"

#: app/pam/templates/pam_gap_analysis.html:39
msgid "Кажани"
msgstr "Bats"

#: app/pam/templates/pam_gap_analysis.html:40
msgid "Усі групи"
msgstr "All groups"

#: app/pam/templates/pam_gap_analysis.html:50
msgid "Будь-яка модель"
msgstr "Any model"

